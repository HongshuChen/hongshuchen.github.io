{% comment %}
  "🌍 Visitor Map" button above the footer (included from _includes/footer.liquid). It opens a spinning globe with a
  red point for every city visitors came from; the behaviour is in assets/js/visitor-map.js. Visits are counted by the
  visitor-stats Cloudflare Worker in visitor-stats/ (see its README), whose address is visitor_map.api_url in _config.yml
  (visitor_map.fallback_api_url is tried when that cannot be reached).
{% endcomment %}
<section
  id="visitor-map"
  class="visitor-map"
  aria-label="Visitor locations"
  data-api="{{ site.visitor_map.api_url }}"
  data-api-fallback="{{ site.visitor_map.fallback_api_url }}"
  data-origins="{{ site.url }}"
  data-globe-script="{{ '/assets/visitor-map/globe.gl.min.js' | relative_url | bust_file_cache }}"
  data-texture-light="{{ '/assets/visitor-map/land-dots-light.png' | relative_url | bust_file_cache }}"
  data-texture-dark="{{ '/assets/visitor-map/land-dots-dark.png' | relative_url | bust_file_cache }}"
>
  <link rel="stylesheet" href="{{ '/assets/css/visitor-map.css' | relative_url | bust_file_cache }}">
  <button class="visitor-map-button visitor-map-toggle" type="button" aria-controls="visitor-map-panel" aria-expanded="false">🌍 Visitor Map</button>
  <div class="visitor-map-panel" id="visitor-map-panel" hidden>
    <p class="visitor-map-summary" role="status" aria-live="polite"></p>
    <p class="visitor-map-note" hidden></p>
    <div class="visitor-map-globe" aria-hidden="true"></div>
    <button class="visitor-map-button visitor-map-retry" type="button" hidden>Try again</button>
  </div>
</section>
<script defer src="{{ '/assets/js/visitor-map.js' | relative_url | bust_file_cache }}"></script>
